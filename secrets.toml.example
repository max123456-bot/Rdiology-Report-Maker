# Copy this file to .streamlit/secrets.toml and put your real key in it.
#
#     mkdir .streamlit
#     copy secrets.toml.example .streamlit\secrets.toml
#
# Then open .streamlit/secrets.toml and replace the placeholder below.
# The app reads it automatically at startup - nobody has to paste a key.
#
# .streamlit/secrets.toml is gitignored, so the key never reaches a repository.
# Never commit it, never put it in a screenshot, never paste it into a chat.
#
# Get a free key (no credit card) at https://aistudio.google.com

GEMINI_API_KEY = "paste-your-key-here"

# Optional, and best left commented out. With no value here the app picks the
# newest model Google offers your key (it prefers `gemini-flash-latest`, which
# Google keeps pointed at the current release), so it stays current on its own.
# Uncomment only to pin a specific model.
# GEMINI_MODEL = "gemini-flash-latest"

# ---------------------------------------------------------------------------
# Optional: AI4Bharat speech recognition for the Dictate tab.
#
# AI4Bharat (IIT Madras) is trained on Indian speech across 22 languages and
# hears Indian accents and Hindi/English mixing far better than a general model.
# Two ways to run it:
#
#   Hosted   - free token from https://huggingface.co/settings/tokens.
#              Nothing to install. The audio goes to Hugging Face.
#   Local    - pip install torch transformers, then set AI4BHARAT_LOCAL = "true".
#              A one-time model download of a gigabyte or so, then fully offline.
#              This is the right choice for identifiable patient dictation.

# HF_TOKEN = "hf_..."

# Starting values for the Dictate tab; both are switchable in the app.
# AI4BHARAT_MODEL = "ai4bharat/indicwhisper"
# AI4BHARAT_LANGUAGE = "hi"
# AI4BHARAT_LOCAL = "false"

# ---------------------------------------------------------------------------
# Optional: where templates and the activity log are stored.
#
# Absent            JSON files in templates/. Correct for one clinic PC.
# sqlite:///...     One transactional file. Use for a shared drive, or when
#                   several browser tabs edit templates at the same time.
# postgresql://...  A real server. REQUIRED on Streamlit Cloud, whose filesystem
#                   is wiped on every restart - without this you lose every
#                   doctor template and everything the app has learned.
#
# Move existing templates across with:  python migrate_storage.py --to "<url>"
# Nothing is deleted from the old store, so you can switch back.

# STORAGE_URL = "sqlite:///data/reports.db"
# STORAGE_URL = "postgresql://user:password@host:5432/reports"

# ---------------------------------------------------------------------------
# Optional: sign-in, so the activity log records who did what.
# Streamlit fills st.user once this is configured with any OIDC provider.
# Docs: https://docs.streamlit.io/develop/concepts/connections/authentication

# [auth]
# redirect_uri = "http://localhost:8501/oauth2callback"
# cookie_secret = "a long random string"
# client_id = "..."
# client_secret = "..."
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# ---------------------------------------------------------------------------
# Optional: gate access. Leave unset on a clinic LAN where everyone is trusted.
# REQUIRED before the app is reachable from outside the building - see DEPLOY.md.
#
# One shared code. Simple, stops drive-by access, but the activity log cannot
# say WHO acted. Configure [auth] above instead for names in the log.

# ACCESS_CODE = "pick something long that is not the clinic name"

# ---------------------------------------------------------------------------
# Optional: which clinic this install belongs to.
#
# Every template, and everything the app learns, is scoped to a tenant. Two
# clinics on the same deployment cannot see each other's doctors, letterheads
# or learned vocabulary.
#
# You usually do NOT need to set this:
#   * with sign-in configured, the tenant comes from the user's email domain,
#     which they cannot fake
#   * with no sign-in, everything lives under "default"
#
# Set it only for a single-clinic install that wants a named tenant, or when
# running two clinics from one machine.

# TENANT = "apollo-andheri"

# ---------------------------------------------------------------------------
# Optional: critical result alerts (the button appears on stat/urgent reports
# once at least one channel below is configured; nothing sends automatically).
#
# Email over any SMTP server:

# ALERT_SMTP_HOST = "smtp.gmail.com"
# ALERT_SMTP_PORT = "587"
# ALERT_SMTP_USER = "clinic@example.com"
# ALERT_SMTP_PASSWORD = "an app password, not the login password"
# ALERT_FROM = "clinic@example.com"

# SMS and WhatsApp via Twilio (console.twilio.com):

# TWILIO_ACCOUNT_SID = "AC..."
# TWILIO_AUTH_TOKEN = "..."
# TWILIO_FROM = "+1..."          # or "whatsapp:+1..." for a WhatsApp sender

# ---------------------------------------------------------------------------
# Optional: PACS connectivity.
#
# Orthanc (free DICOM server, orthanc-server.com): point the app at it and the
# Worklist tab's PACS panel lists its studies, fetches .dcm files for the
# cross-check, and feeds previews to the AI pre-read. Works from Streamlit
# Cloud too - the app dials out.

# ORTHANC_URL = "https://pacs.clinic.example:8042"
# ORTHANC_USERNAME = "orthanc"
# ORTHANC_PASSWORD = "..."

# The C-STORE receiver (modalities push directly to this machine) needs no
# secrets - configure AE title and port in the Worklist tab. LAN install only.

# ---------------------------------------------------------------------------
# Optional: which AI vendor serves the model calls. Gemini is the default;
# "ollama" selects the air-gapped local path below.

# AI_PROVIDER = "gemini"

# ---------------------------------------------------------------------------
# Optional: the air-gapped AI path. Run `ollama serve` with a capable model on
# a machine in the building, and drafting/impressions/second-opinion run with
# no cloud at all. Vision (scan pre-read, OCR) needs Gemini and stays hidden
# on this provider.

# OLLAMA_URL = "http://127.0.0.1:11434"
# OLLAMA_MODEL = "qwen2.5:7b-instruct"

# ---------------------------------------------------------------------------
# Optional: de-identify before the cloud. With this on, every text sent to a
# cloud model first has names, MRN/UHID numbers, phones, emails and dates
# swapped for placeholders, and the answer swapped back. The cloud sees
# "[NAME-1]"; the clinic sees the patient.

# DEID_CLOUD = "true"

# ---------------------------------------------------------------------------
# Optional: PHI encryption at rest. With a key set, every report record's
# payload is AES-256-GCM encrypted before it reaches the database or the JSON
# files, and the patient_key filter column becomes a keyed hash. A copied
# database file is then unreadable. LOSING THIS KEY LOSES THE RECORDS - keep
# it somewhere that is not this file's deployment.

# PHI_KEY = "a long random passphrase"

# ---------------------------------------------------------------------------
# Optional: non-repudiation. With a key set, signing a report produces an
# HMAC-SHA256 signature over the exact signed text, and the audit
# attestation chain is signed too - proving not just that nothing changed,
# but that THIS system signed it.

# ATTEST_KEY = "a different long random passphrase"

# ---------------------------------------------------------------------------
# Optional: roles. Unconfigured, everyone is "attending" (full capability -
# the solo-clinic behaviour). Signing needs attending; residents and
# transcriptionists draft; admin delivers and manages; auditor reads.

# ROLE_MAP = "dra@clinic.in:attending, resident1@clinic.in:resident"
# ROLE_DEFAULT = "resident"

# ---------------------------------------------------------------------------
# Optional: hospital integration.
#
# Outbound HL7: finished reports pushed as ORU^R01 over MLLP to the RIS/EHR.
# The inbound ORM order listener is started from the Worklist tab (LAN only).

# MLLP_HOST = "192.168.1.50"
# MLLP_PORT = "6661"

# DICOMweb (QIDO-RS/WADO-RS), e.g. an Orthanc's /dicom-web root. Falls back
# to the ORTHANC_* credentials when its own are not set.

# DICOMWEB_URL = "https://pacs.clinic.example:8042/dicom-web"
# DICOMWEB_USERNAME = "orthanc"
# DICOMWEB_PASSWORD = "..."
